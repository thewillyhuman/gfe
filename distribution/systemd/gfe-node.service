[Unit]
Description=GFE Node - General Front End (L7 TLS-terminating HTTP reverse proxy)
Documentation=https://github.com/thewillyhuman/gfe
After=network-online.target
Wants=network-online.target
# Give up on a node that fails five times within a minute, instead of
# restarting it for ever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# The node tells systemd when it serves and, after it has replaced itself
# (see ExecReload), which process the service now is.
Type=notify

# Run as a dedicated unprivileged user. The RPM creates it; when installing
# by hand, create it once:
#     useradd --system --no-create-home --shell /usr/sbin/nologin gfe-node
User=gfe-node
Group=gfe-node

# /usr/bin is where the RPM installs the binary; adjust if it lives elsewhere.
#
# There is deliberately no ExecStartPre running --check-config: the node
# validates its config when it starts, and if the deployed dynamic config is
# missing or broken it starts from its last-known-good cache instead of not
# starting at all. A pre-start check would turn that into an outage.
ExecStart=/usr/bin/gfe-node --config /etc/gfe/gfe.toml

# Reload upgrades the node in place: it starts the binary now on disk (a new
# package, or a changed gfe.toml), hands it its listening sockets, and drains
# once the new process accepts connections. No connection is refused. If the
# new process does not start, the running one goes on serving and says why
# in `systemctl status` and the journal. `systemctl reload` does not wait
# for the outcome.
#
# The dynamic config needs no reload: GFE picks it up when the file changes.
# SIGHUP (`kill -HUP`, a logrotate postrotate) and SIGUSR1 do nothing but
# log a warning.
ExecReload=/bin/kill -USR2 $MAINPID

Restart=on-failure
RestartSec=5s

# Many concurrent client + upstream connections need a high FD ceiling.
LimitNOFILE=1048576

# What the node needs beyond an unprivileged user:
#
#   CAP_NET_BIND_SERVICE   binding low ports (443/80) for its listeners.
#   CAP_BPF, CAP_NET_ADMIN loading the eBPF program behind its kernel view
#                          (accept-queue wait, round-trip time,
#                          retransmissions, how connections end) and
#                          attaching it to the service's own cgroup.
#
# CAP_NET_ADMIN is a real widening of what a compromised node could do: it
# can reconfigure the host's network. To run without it, drop the two eBPF
# capabilities and the `bpf` system call below: the node then logs that it
# is not permitted to load eBPF, reports `gfe_ebpf_attached 0`, and serves
# without the kernel view.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_BPF CAP_NET_ADMIN

# Security hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# /var/lib/gfe (the last-known-good config cache) and /var/log/gfe (the log
# file, if `[log] file` names one there): created and owned by the service
# user on start, and the only writable paths. The log holds client addresses
# and what they asked for, so its directory is closed to other users; give a
# log collector access through the gfe-node group.
StateDirectory=gfe
LogsDirectory=gfe
LogsDirectoryMode=0750
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @swap @debug
# Allowed back after the exclusions above: loading the eBPF program.
SystemCallFilter=bpf

# Graceful drain: GFE drains in-flight requests on SIGTERM up to its
# drain_deadline; give systemd enough time before SIGKILL.
TimeoutStopSec=45s
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gfe-node

Environment=RUST_LOG=info
# A panic is logged with its backtrace. An error the node exits with (a
# gfe.toml it cannot read, say) is not: its message says what is wrong, and
# twenty lines of stack frames after it in the journal say nothing more.
Environment=RUST_BACKTRACE=1
Environment=RUST_LIB_BACKTRACE=0

[Install]
WantedBy=multi-user.target
