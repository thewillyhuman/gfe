{
  "uid": "gfe-logs",
  "title": "GFE — Logs",
  "tags": [
    "gfe",
    "logs"
  ],
  "schemaVersion": 39,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "10s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "client",
        "label": "Client IP (regex, filters every panel)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "A regular expression on the client address. Everything except the node's own events is restricted to matching clients."
      },
      {
        "name": "search",
        "label": "Access log contains (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "title": "Traffic",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Requests/s by status",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (fields_status) (rate({job=\"gfe\", target=\"gfe::access\"} | json | fields_client =~ \"$client\" [$__auto]))",
          "legendFormat": "{{fields_status}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "description": "Counted from the access log. 499 = the client gave up before any response.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Requests/s by gRPC status",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (fields_grpc_status) (rate({job=\"gfe\", target=\"gfe::access\"} | json | fields_client =~ \"$client\" | fields_grpc_status != \"\" [$__auto]))",
          "legendFormat": "grpc-status {{fields_grpc_status}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "description": "gRPC calls are HTTP 200 whatever their outcome; this is the status that matters. 0 is OK.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "p99 duration by route",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "quantile_over_time(0.99, {job=\"gfe\", target=\"gfe::access\"} | json | fields_client =~ \"$client\" | unwrap fields_duration_ms [$__auto]) by (fields_route)",
          "legendFormat": "{{fields_route}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "description": "Request head to the last byte of the response.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Why GFE answered instead of a backend",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (fields_error) (rate({job=\"gfe\", target=\"gfe::access\"} | json | fields_client =~ \"$client\" | fields_error != \"\" [$__auto]))",
          "legendFormat": "{{fields_error}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "description": "The access log's `error` field: no route, no healthy upstream, backend unreachable, timeouts.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Exchanges broken off, by who and where",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum by (fields_termination, fields_route) (rate({job=\"gfe\", target=\"gfe::access\"} | json | fields_client =~ \"$client\" | fields_termination != \"complete\" [$__auto]))",
          "legendFormat": "{{fields_termination}} · {{fields_route}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Requests served per backend",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sort_desc(topk(10, sum by (fields_backend) (count_over_time({job=\"gfe\", target=\"gfe::access\"} | json | fields_client =~ \"$client\" | fields_backend != \"\" [$__range]))))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "displayName": "${__cell_1}   "
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "limit": 20
        },
        "sizing": "manual",
        "minVizHeight": 14,
        "maxVizHeight": 18,
        "minVizWidth": 8,
        "text": {
          "valueSize": 16
        }
      }
    },
