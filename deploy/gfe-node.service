[Unit]
Description=GFE Node - General Front End (L7 TLS-terminating reverse proxy)
Documentation=https://github.com/thewillyhuman/gfe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run as a dedicated unprivileged user. Create it once at install time:
#     useradd --system --no-create-home --shell /usr/sbin/nologin gfe-node
User=gfe-node
Group=gfe-node

# Validate config before starting, then run.
ExecStartPre=/usr/local/bin/gfe-node --config /etc/gfe/gfe.toml --check-config
ExecStart=/usr/local/bin/gfe-node --config /etc/gfe/gfe.toml

# Reload semantics: GFE hot-reloads the dynamic config on file change, so a
# SIGHUP is not required. `systemctl reload` is a no-op; just rewrite the
# dynamic JSON and GFE picks it up.

Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=5

# Many concurrent client + upstream connections need a high FD ceiling.
LimitNOFILE=1048576

# GFE is a userspace proxy: the only elevated privilege it needs is binding
# low ports (443/80) for its listeners. GRE decapsulation and the loopback VIP
# are set up by deploy/backend-onboard.sh and handled by the kernel, not GFE.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Security hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/gfe
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @reboot @swap @debug

# Graceful drain: GFE drains in-flight requests on SIGTERM up to its
# drain_deadline; give systemd enough time before SIGKILL.
TimeoutStopSec=45s
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=gfe-node

Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=multi-user.target
