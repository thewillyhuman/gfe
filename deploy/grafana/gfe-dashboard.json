{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "GFE — General Front End",
  "tags": ["gfe", "proxy", "tls"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(gfe_connections_active, instance)",
        "refresh": 2,
        "includeAll": true
      },
      {
        "name": "host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(gfe_requests_total{instance=~\"$instance\"}, host)",
        "refresh": 2,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "pool",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(gfe_upstream_requests_total{instance=~\"$instance\"}, pool)",
        "refresh": 2,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "title": "Request rate by route", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (route) (rate(gfe_requests_total{instance=~\"$instance\", host=~\"$host\"}[1m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 2, "title": "Request rate by host (DNS alias)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (host) (rate(gfe_requests_total{instance=~\"$instance\"}[1m]))", "legendFormat": "{{host}}" }
      ]
    },
    {
      "id": 3, "title": "Request p95 latency by route", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, route) (rate(gfe_request_duration_seconds_bucket{instance=~\"$instance\", host=~\"$host\"}[5m])))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 4, "title": "5xx rate by route", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (route) (rate(gfe_requests_total{instance=~\"$instance\", status=~\"5..\"}[1m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 5, "title": "Active connections", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "gfe_connections_active{instance=~\"$instance\"}", "legendFormat": "{{instance}}" } ]
    },
    {
      "id": 6, "title": "TLS handshakes/s by result", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "sum by (result) (rate(gfe_tls_handshakes_total{instance=~\"$instance\"}[1m]))", "legendFormat": "{{result}}" } ]
    },
    {
      "id": 7, "title": "TLS handshake p95", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "histogram_quantile(0.95, sum by (le) (rate(gfe_tls_handshake_duration_seconds_bucket{instance=~\"$instance\"}[5m])))", "legendFormat": "p95" } ]
    },
    {
      "id": 8, "title": "Upstream request rate by backend", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (pool, backend) (rate(gfe_upstream_requests_total{instance=~\"$instance\", pool=~\"$pool\"}[1m]))", "legendFormat": "{{pool}}/{{backend}}" }
      ]
    },
    {
      "id": 9, "title": "Upstream p95 latency by backend", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(gfe_upstream_request_duration_seconds_bucket{instance=~\"$instance\", pool=~\"$pool\"}[5m])))", "legendFormat": "{{backend}}" }
      ]
    },
    {
      "id": 10, "title": "Upstream 5xx + connect errors", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (backend) (rate(gfe_upstream_requests_total{instance=~\"$instance\", pool=~\"$pool\", status=~\"5..\"}[1m]))", "legendFormat": "5xx {{backend}}" },
        { "expr": "sum(rate(gfe_upstream_connect_errors_total{instance=~\"$instance\"}[1m]))", "legendFormat": "connect errors" },
        { "expr": "sum(rate(gfe_no_healthy_upstream_total{instance=~\"$instance\"}[1m]))", "legendFormat": "no healthy upstream" }
      ]
    },
    {
      "id": 11, "title": "Backend health (1=healthy)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "gfe_backend_health_status{instance=~\"$instance\", pool=~\"$pool\"}", "legendFormat": "{{pool}}/{{backend}}" }
      ]
    },
    {
      "id": 12, "title": "Days until cert expiry", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "d" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "(gfe_cert_expiry_timestamp{instance=~\"$instance\"} - time()) / 86400", "legendFormat": "{{sni}}" } ]
    },
    {
      "id": 13, "title": "Config reload errors (total)", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "sum(gfe_config_reload_errors_total{instance=~\"$instance\"})" } ]
    },
    {
      "id": 14, "title": "Draining backends", "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [ { "expr": "sum(gfe_backend_draining{instance=~\"$instance\"})" } ]
    },
    {
      "id": 15, "title": "Requests in flight", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (instance) (gfe_requests_in_flight{instance=~\"$instance\"})", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 16, "title": "Aborted requests/s by who", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (by, route) (rate(gfe_requests_aborted_total{instance=~\"$instance\", host=~\"$host\"}[5m]))", "legendFormat": "{{by}} · {{route}}" }
      ]
    },
    {
      "id": 17, "title": "Connections closed/s by reason", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (reason) (rate(gfe_connections_closed_total{instance=~\"$instance\"}[5m]))", "legendFormat": "{{reason}}" }
      ]
    },
    {
      "id": 18, "title": "Connection saturation (active / limit)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "gfe_connections_active{instance=~\"$instance\"} / gfe_connections_limit{instance=~\"$instance\"}", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 19, "title": "File descriptor saturation (open / max)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "process_open_fds{instance=~\"$instance\"} / process_max_fds{instance=~\"$instance\"}", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 20, "title": "CPU cores in use and runtime queue", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{instance=~\"$instance\"}[5m])", "legendFormat": "cores · {{instance}}" },
        { "expr": "gfe_runtime_global_queue_depth{instance=~\"$instance\"}", "legendFormat": "queued tasks · {{instance}}" }
      ]
    },
    {
      "id": 21, "title": "Wire throughput by listener", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 64 },
      "fieldConfig": { "defaults": { "unit": "Bps" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (listener) (rate(gfe_bytes_in_total{instance=~\"$instance\"}[5m]))", "legendFormat": "in · {{listener}}" },
        { "expr": "sum by (listener) (rate(gfe_bytes_out_total{instance=~\"$instance\"}[5m]))", "legendFormat": "out · {{listener}}" }
      ]
    },
    {
      "id": 22, "title": "TLS handshake failures/s by reason", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 64 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (reason) (rate(gfe_tls_handshake_failures_total{instance=~\"$instance\"}[5m]))", "legendFormat": "{{reason}}" }
      ]
    },
    {
      "id": 23, "title": "TLS connections/s by version and cipher", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 64 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (version, cipher, resumed) (rate(gfe_tls_connections_total{instance=~\"$instance\"}[5m]))", "legendFormat": "{{version}} {{cipher}} resumed={{resumed}}" }
      ]
    },
    {
      "id": 24, "title": "Upstream errors/s by kind", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 72 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (pool, kind) (rate(gfe_upstream_errors_total{instance=~\"$instance\", pool=~\"$pool\"}[5m]))", "legendFormat": "{{pool}} · {{kind}}" }
      ]
    },
    {
      "id": 25, "title": "Upstream requests in flight by backend", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 72 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (pool, backend) (gfe_upstream_requests_in_flight{instance=~\"$instance\", pool=~\"$pool\"})", "legendFormat": "{{pool}}/{{backend}}" }
      ]
    },
    {
      "id": 26, "title": "gRPC calls/s by status (0 = OK)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 72 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (route, grpc_status) (rate(gfe_grpc_responses_total{instance=~\"$instance\", host=~\"$host\"}[5m]))", "legendFormat": "{{route}} · {{grpc_status}}" }
      ]
    },
    {
      "id": 27, "title": "Host: TCP retransmission ratio (node_exporter)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 80 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(node_netstat_Tcp_RetransSegs[5m]) / rate(node_netstat_Tcp_OutSegs[5m])", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "id": 28, "title": "Host: interface errors and drops/s (node_exporter)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 80 },
      "fieldConfig": { "defaults": { "unit": "pps" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(node_network_receive_errs_total{device!=\"lo\"}[5m]) + rate(node_network_transmit_errs_total{device!=\"lo\"}[5m])", "legendFormat": "errors · {{instance}} {{device}}" },
        { "expr": "rate(node_network_receive_drop_total{device!=\"lo\"}[5m]) + rate(node_network_transmit_drop_total{device!=\"lo\"}[5m])", "legendFormat": "drops · {{instance}} {{device}}" }
      ]
    },
    {
      "id": 29, "title": "Host: listen queue overflows/s (node_exporter)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 80 },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(node_netstat_TcpExt_ListenOverflows[5m])", "legendFormat": "{{instance}}" }
      ]
    }
  ]
}
